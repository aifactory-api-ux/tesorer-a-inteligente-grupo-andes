{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "${AZURE_AD_DOMAIN}",
    "ClientId": "${AZURE_AD_CLIENT_ID}",
    "TenantId": "${AZURE_AD_TENANT_ID}",
    "CallbackPath": "/signin-oidc",
    "ClientSecret": "${AZURE_AD_CLIENT_SECRET}"
  },
  "AzureStorage": {
    "ConnectionString": "${AZURE_STORAGE_CONNECTION_STRING}",
    "ContainerName": "bank-statements",
    "AccountName": "${AZURE_STORAGE_ACCOUNT_NAME}",
    "AccountKey": "${AZURE_STORAGE_ACCOUNT_KEY}"
  },
  "KeyVault": {
    "VaultUri": "https://${KEY_VAULT_NAME}.vault.azure.net/",
    "ClientId": "${KEY_VAULT_CLIENT_ID}",
    "ClientSecret": "${KEY_VAULT_CLIENT_SECRET}"
  },
  "App": {
    "ServiceName": "Tesorería Inteligente Grupo Andes",
    "Version": "1.0.0",
    "DefaultPageSize": 50,
    "MaxPageSize": 100
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}"
  }
}
